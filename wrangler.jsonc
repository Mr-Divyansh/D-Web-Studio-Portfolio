{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "d-web-studio-portfolio",
  "compatibility_date": "2026-09-19",
  "assets": {
    "directory": "./",
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}